// Entendido. El problema es que el código anterior solamente procesa las imágenes que están cargadas en el DOM en ese momento. 
// Si la página tiene 382 páginas (1/382) y carga el contenido conforme avanzas, el script no encontrará las 382 imágenes.
// Hay que incorporar un sistema de detección de páginas, desplazamiento progresivo y recopilación de imágenes antes de generar el PDF.
// Te dejo una versión mejorada que intenta recorrer el contenido cargado progresivamente, sin saltarse imágenes que todavía no estén disponibles.
// Código completo para Firefox

(async function exportarTodasLasPaginas() {
    "use strict";

    const CONFIG = {
        totalPaginas: 382,
        nombrePDF: "documento_completo.pdf",
        calidad: 1.0,
        intervaloCarga: 250,
        intentosCarga: 12,
        maxPixels: 40000000
    };

    console.log("Iniciando recopilación de páginas...");

    // Evitar ejecuciones simultáneas
    if (window.__exportandoPDF) {
        console.warn("Ya existe una exportación en curso.");
        return;
    }

    window.__exportandoPDF = true;

    try {
        // Comprobar jsPDF
        if (!window.jspdf?.jsPDF) {
            throw new Error(
                "jsPDF no está cargado. Cárgalo mediante un método autorizado por la CSP."
            );
        }

        const { jsPDF } = window.jspdf;

        // Recopilar imágenes sin duplicarlas
        const recopiladas = new Map();

        function obtenerImagenes() {
            document.querySelectorAll("img").forEach(img => {
                const src = img.currentSrc || img.src;

                if (!src || !src.startsWith("blob:")) return;

                if (!recopiladas.has(src)) {
                    recopiladas.set(src, img);
                }
            });
        }

        // Buscar indicador de página actual
        function leerPaginaActual() {
            const texto = document.body.innerText;

            const coincidencia = texto.match(
                /(\d{1,3})\s*\/\s*382/
            );

            return coincidencia
                ? Number(coincidencia[1])
                : null;
        }

        // Desplazamiento progresivo para activar carga diferida
        async function recorrerDocumento() {
            const alturaOriginal = window.scrollY;

            const alturaTotal = Math.max(
                document.documentElement.scrollHeight,
                document.body.scrollHeight
            );

            const pasos = Math.max(
                CONFIG.totalPaginas,
                Math.ceil(alturaTotal / window.innerHeight)
            );

            for (let i = 0; i <= pasos; i++) {
                const posicion =
                    (alturaTotal * i) / pasos;

                window.scrollTo(0, posicion);

                await new Promise(resolve =>
                    setTimeout(resolve, CONFIG.intervaloCarga)
                );

                obtenerImagenes();

                console.log(
                    "Recorrido:",
                    i + 1,
                    "/",
                    pasos,
                    "| Imágenes:",
                    recopiladas.size,
                    "| Página:",
                    leerPaginaActual()
                );
            }

            // Restaurar posición
            window.scrollTo(0, alturaOriginal);
        }

        // 1. Recopilar imágenes actuales
        obtenerImagenes();

        // 2. Recorrer el documento para activar carga diferida
        await recorrerDocumento();

        // 3. Segunda recopilación
        obtenerImagenes();

        console.log(
            "Total de imágenes recopiladas:",
            recopiladas.size
        );

        if (recopiladas.size === 0) {
            throw new Error("No se encontraron imágenes Blob.");
        }

        // 4. Convertir las imágenes en datos independientes
        const imagenesPDF = [];

        let indice = 0;

        for (const [src, img] of recopiladas) {
            indice++;

            try {
                let imagen = img;

                // Si la imagen original fue reemplazada,
                // intentar recuperar el recurso Blob.
                if (!img.complete || !img.naturalWidth) {
                    await new Promise(resolve => {
                        let terminado = false;

                        const finalizar = () => {
                            if (terminado) return;
                            terminado = true;
                            resolve();
                        };

                        img.addEventListener("load", finalizar, {
                            once: true
                        });

                        img.addEventListener("error", finalizar, {
                            once: true
                        });

                        setTimeout(finalizar, 5000);
                    });
                }

                if (!imagen.naturalWidth) {
                    console.warn("Imagen no disponible:", indice);
                    continue;
                }

                const width = imagen.naturalWidth;
                const height = imagen.naturalHeight;

                if (width * height > CONFIG.maxPixels) {
                    console.warn("Imagen demasiado grande:", indice);
                    continue;
                }

                const canvas = document.createElement("canvas");

                canvas.width = width;
                canvas.height = height;

                const ctx = canvas.getContext("2d");

                ctx.drawImage(imagen, 0, 0);

                const data = canvas.toDataURL(
                    "image/jpeg",
                    CONFIG.calidad
                );

                imagenesPDF.push({
                    data,
                    width,
                    height
                });

                console.log(
                    `Imagen preparada: ${indice}/${recopiladas.size}`
                );

            } catch (error) {
                console.error(
                    `Error en imagen ${indice}:`,
                    error
                );
            }
        }

        // 5. Generar PDF
        if (!imagenesPDF.length) {
            throw new Error("No hay imágenes válidas para el PDF.");
        }

        let pdf = null;

        imagenesPDF.forEach((imagen, index) => {
            const orientacion =
                imagen.width > imagen.height
                    ? "landscape"
                    : "portrait";

            if (index === 0) {
                pdf = new jsPDF({
                    orientation: orientacion,
                    unit: "px",
                    format: [
                        imagen.width,
                        imagen.height
                    ],
                    hotfixes: ["px_scaling"],
                    compress: true
                });
            } else {
                pdf.addPage(
                    [imagen.width, imagen.height],
                    orientacion
                );
            }

            pdf.addImage(
                imagen.data,
                "JPEG",
                0,
                0,
                imagen.width,
                imagen.height,
                undefined,
                "FAST"
            );
        });

        // 6. Descargar
        pdf.save(CONFIG.nombrePDF);

        console.log("--------------------------------");
        console.log("EXPORTACIÓN FINALIZADA");
        console.log("Páginas encontradas:", recopiladas.size);
        console.log("Páginas incorporadas:", imagenesPDF.length);
        console.log("Páginas solicitadas:", CONFIG.totalPaginas);
        console.log("--------------------------------");

    } catch (error) {
        console.error("ERROR:", error);

    } finally {
        window.__exportandoPDF = false;
    }

})();
